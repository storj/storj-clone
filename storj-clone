#!/bin/sh

set -e

trap 'RC=$?; if test "$RC" != 0 && test "$RC" != 66 ; then echo "Error! Step exited with exit code $RC."; exit $RC; fi' EXIT

usage() {
  echo "usage: $0 [repository [destination]]"
  echo ""
  echo "storj-clone clones the specified repository from gerrit into the optional destination."
  echo "If no repository is specified, it looks at the current directory to see if it is a"
  echo "git repository, and if so, sets up the gerrit remote, commit hook and support aliases."
  exit 66 # execute order 66
}

if test "$#" != 0 && test "$#" != 1 && test "$#" != 2 ; then
    usage
fi

HOST="${GERRIT%%:*}"
HOST="${HOST:-review.dev.storj.io}"
PORT="${GERRIT#*:}"
PORT="${PORT:-29418}"

GIST_USER="${GIST_USER:-zeebo}"
GIST_ID="${GIST_ID:-108b15abab91cc3d9cfbf367090d6fa5}"
GIST_REV="/${GIST_REV:-}"
GIST_BASE="${GIST_BASE:-https://gist.githubusercontent.com/${GIST_USER}/${GIST_ID}/raw${GIST_REV}}"

# set up the repo by looking at the current git directory if none is specified, then
# by the command line argument, and otherwise error. the destination will be the
# absolute path to the git repository, then the command line argument, then the
# name of the repo.

if test "$#" == 0 ; then
    DEST=$(git rev-parse --show-toplevel 2>/dev/null || true)
    REPO=$(basename "${DEST}")
fi
if test -z "${REPO}" ; then
    REPO="$1"
fi
if test -z "${REPO}" ; then
    usage
fi
if test -z "${DEST}" ; then
    DEST="${2:-${REPO}}"
fi

# find the username to use with gerrit. this should be either the github.user config key
# and if that doesn't exist, we'll try to ssh to github to get them to tell us our username.
# if none of that works, we ask the user to set it.

USER="$(git config --global --get github.user || true)"
if test -z "${USER}" ; then
    echo "Unable to find github username in git config. Checking with github..."

    USER="$(ssh -xT git@github.com 2>&1 | awk '$1=="Hi" {print $2}' | sed -e 's/!//g' || true)"

    if test -z "${USER}" ; then
        echo "Unable to find github username with github. Please run"
        echo ""
        echo "    git config --global --add github.user <your github username>"
        echo ""
        echo "and then run $0 $* again."
        exit 1
    fi

    echo "Detected your github username to be ${USER}. Running"
    echo ""
    echo "    git config --global --add github.user ${USER}"
    echo ""

    git config --global --add github.user "${USER}"
fi

REMOTE="ssh://${USER}@${HOST}:${PORT}/storj/${REPO}"

( # Clone the repository if it doesn't already exist

    if test ! -e "${DEST}" ; then
        git clone "${REMOTE}" "${DEST}"
    fi
)

( # Add/update the gerrit remote

    cd "${DEST}"

    GERRIT_REMOTE="$(git config remote.gerrit.url || true)"
    ORIGIN_REMOTE="$(git config remote.origin.url || true)"

    if test "z${REMOTE}" != "z${GERRIT_REMOTE}" && test "z${REMOTE}" != "z${ORIGIN_REMOTE}" ; then
        if test -z "${GERRIT_REMOTE}"; then
            echo "Adding gerrit remote with ${REMOTE}..."
            git remote add gerrit "${REMOTE}"
        else
            echo "Setting gerrit remote to ${REMOTE}..."
            git remote set-url gerrit "${REMOTE}"
        fi

        git fetch gerrit
    fi
)

( # Add/update the commit-msg hook

    if test -f "${DEST}/.git/hooks/commit-msg" ; then
        echo "Updating commit-msg hook..."
    else
        echo "Adding commit-msg hook..."
    fi

    cd "${DEST}"

    mkdir -p ".git/hooks"
    rm -f ".git/hooks/commit-msg"
    curl -LsSo ".git/hooks/commit-msg" "https://${HOST}/tools/hooks/commit-msg"
    chmod +x ".git/hooks/commit-msg"
)

( # Add/update the gerrit-support scripts and aliases

    if test -d "${DEST}/.git/gerrit" ; then
        echo "Updating gerrit-support aliases..."
    else
        echo "Adding gerrit-support aliases..."
    fi

    cd "${DEST}"

    mkdir -p ".git/gerrit"

    rm -f ".git/gerrit/gerrit-support"
    curl -LsSo ".git/gerrit/gerrit-support" "${GIST_BASE}/gerrit-support"

    rm -f ".git/gerrit/push-wip"
    curl -LsSo ".git/gerrit/push-wip" "${GIST_BASE}/push-wip"
    chmod +x ".git/gerrit/push-wip"
    git config alias.push-wip "!./.git/gerrit/push-wip"

    rm -f ".git/gerrit/push-review"
    curl -LsSo ".git/gerrit/push-review" "${GIST_BASE}/push-review"
    chmod +x ".git/gerrit/push-review"
    git config alias.push-review "!./.git/gerrit/push-review"

    rm -f ".git/gerrit/reset-to"
    curl -LsSo ".git/gerrit/reset-to" "${GIST_BASE}/reset-to"
    chmod +x ".git/gerrit/reset-to"
    git config alias.reset-to "!./.git/gerrit/reset-to"

    rm -f ".git/gerrit/pick"
    curl -LsSo ".git/gerrit/pick" "${GIST_BASE}/pick"
    chmod +x ".git/gerrit/pick"
    git config alias.pick "!./.git/gerrit/pick"

    rm -f ".git/gerrit/changeset"
    curl -LsSo ".git/gerrit/changeset" "${GIST_BASE}/changeset"
    chmod +x ".git/gerrit/changeset"
    git config alias.changeset "!./.git/gerrit/changeset"
)
