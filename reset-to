#!/usr/bin/env bash
source $(dirname $0)/gerrit-support

if [ "z$(git status --untracked-files=no --porcelain)" != "z" ]; then
    echo "It is unsafe to reset --hard with a dirty status. Please commit/stash and try again."
    exit 1
fi

if [ $# -eq 1 ]; then
    REF="$($(dirname $0)/changeset "$1")"
else
    cache_remote_branch
    REF=$REMOTE_BRANCH
fi

cache_remote_push

run git fetch "$REMOTE_PUSH" "$REF"
run git reset --hard FETCH_HEAD
